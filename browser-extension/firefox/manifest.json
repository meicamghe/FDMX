{
  "manifest_version": 2,
  "name": "GNS Downloader Connector",
  "version": "6.3.0",
  "description": "Send the current page or a link directly to GNS Downloader.",
  "permissions": ["activeTab", "contextMenus", "storage", "http://127.0.0.1:47831/*"],
  "browser_action": { "default_title": "Send to GNS Downloader", "default_popup": "popup.html" },
  "background": { "scripts": ["background.js"] },
  "browser_specific_settings": { "gecko": { "id": "fdmx-browser@gns.local", "strict_min_version": "109.0" } }
}