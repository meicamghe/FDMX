{
  "manifest_version": 2,
  "name": "FDMX Download Manager",
  "version": "1.1.0",
  "description": "Send links from Firefox to FDMX and resolve GitHub Actions artifacts using your signed-in browser session.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "tabs",
    "http://127.0.0.1:38471/*",
    "https://github.com/*",
    "https://api.github.com/*",
    "https://*.githubusercontent.com/*",
    "https://*.blob.core.windows.net/*",
    "https://*.amazonaws.com/*"
  ],
  "background": {
    "scripts": [
      "github-auth.js",
      "background.js"
    ]
  },
  "browser_action": {
    "default_title": "FDMX",
    "default_popup": "popup.html"
  },
  "applications": {
    "gecko": {
      "id": "fdmx-browser@gns.local",
      "strict_min_version": "109.0"
    }
  }
}
