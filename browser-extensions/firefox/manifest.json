{
  "manifest_version": 3,
  "name": "FDMX Download Manager",
  "version": "1.0.0",
  "description": "Send links and direct media URLs from Firefox to the FDMX desktop download manager.",
  "permissions": ["contextMenus", "activeTab", "tabs", "scripting"],
  "host_permissions": ["http://127.0.0.1:38471/*"],
  "background": {"scripts": ["background.js"]},
  "action": {"default_title": "FDMX Download Manager", "default_popup": "popup.html"},
  "browser_specific_settings": {
    "gecko": {
      "id": "fdmx-browser@gns.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {"required": ["websiteActivity"]}
    }
  },
  "icons": {"128": "icons/icon-128.png"}
}