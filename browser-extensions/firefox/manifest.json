{
  "manifest_version": 2,
  "name": "GNS Downloader",
  "version": "1.3.0",
  "description": "Automatically sends browser downloads to GNS Downloader and offers media and YouTube quality choices.",
  "permissions": [
    "contextMenus", "activeTab", "tabs", "downloads", "notifications",
    "http://127.0.0.1:38471/*",
    "https://github.com/*",
    "https://api.github.com/*",
    "https://*.githubusercontent.com/*",
    "https://*.blob.core.windows.net/*",
    "https://*.amazonaws.com/*",
    "<all_urls>"
  ],
  "background": {"scripts": ["github-auth.js", "background.js"], "persistent": true},
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["media-detect.js"],
    "run_at": "document_idle"
  }],
  "browser_action": {
    "default_title": "GNS Downloader",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/gns-downloader-16.png",
      "32": "icons/gns-downloader-32.png",
      "48": "icons/gns-downloader-48.png",
      "128": "icons/gns-downloader-128.png"
    }
  },
  "icons": {
    "16": "icons/gns-downloader-16.png",
    "32": "icons/gns-downloader-32.png",
    "48": "icons/gns-downloader-48.png",
    "128": "icons/gns-downloader-128.png"
  },
  "applications": {
    "gecko": {
      "id": "fdmx-browser@gns.local",
      "strict_min_version": "109.0"
    }
  }
}
