{
  "manifest_version": 3,
  "name": "FDMX Download Manager",
  "version": "1.0.0",
  "description": "Send links and direct media URLs from Chrome to the FDMX desktop download manager.",
  "permissions": ["contextMenus", "activeTab", "tabs", "scripting"],
  "host_permissions": ["http://127.0.0.1:38471/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "FDMX Download Manager", "default_popup": "popup.html"},
  "icons": {"128": "icons/icon-128.png"}
}