{
  "manifest_version": 3,
  "name": "GNS Downloader",
  "version": "1.2.0",
  "description": "Send links and downloads from Chrome to GNS Downloader, including authenticated GitHub Actions artifacts.",
  "permissions": ["contextMenus", "activeTab", "tabs", "scripting", "downloads", "notifications"],
  "host_permissions": [
    "http://127.0.0.1:38471/*",
    "https://github.com/*",
    "https://api.github.com/*",
    "https://*.githubusercontent.com/*",
    "https://*.blob.core.windows.net/*",
    "https://*.amazonaws.com/*"
  ],
  "background": {"service_worker": "background.js"},
  "action": {
    "default_title": "GNS Downloader",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/gns-downloader-16.png",
      "32": "icons/gns-downloader-32.png",
      "48": "icons/gns-downloader-48.png",
      "128": "icons/gns-downloader-128.png"
    }
  },
  "icons": {
    "16": "icons/gns-downloader-16.png",
    "32": "icons/gns-downloader-32.png",
    "48": "icons/gns-downloader-48.png",
    "128": "icons/gns-downloader-128.png"
  }
}
